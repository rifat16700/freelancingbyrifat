# Cloudflare Pages Environment Variables Example
# You can fill these values and upload this file using the "Import .env" button in Cloudflare Dashboard.

# Tawk.to Live Chat (Optional)
# Example: https://embed.tawk.to/6ac2a6c315e9cf34cad3b1e4/1k445mreb
TAWK_WIDGET_URL=

# JWT Secret for User Authentication
# Put any random hard-to-guess string here.
JWT_SECRET=super_secret_jwt_key_change_this

# Email Settings (Optional, used if you have Email binding configured)
EMAIL_FROM=noreply@yourdomain.com
EMAIL_DOMAIN=yourdomain.com

# Cloudflare Cache Purging (Optional, for auto-clearing cache on updates)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
