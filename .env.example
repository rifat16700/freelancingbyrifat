# ==========================================
# CLOUDFLARE PAGES - ENVIRONMENT VARIABLES
# ==========================================
# Fill in the values for your specific client/setup and upload 
# this file using the "Import .env" button in Cloudflare.

# ------------------------------------------
# 1. CORE & DATABASE SETTINGS
# ------------------------------------------
DB_PROVIDER=""
JWT_SECRET=""
WEBHOOK_SECRET=""
REVALIDATE_SECRET=""

# ------------------------------------------
# 2. ADMIN CREDENTIALS
# ------------------------------------------
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
ADMIN_SECRET_TOKEN=""

# ------------------------------------------
# 3. CLOUDFLARE API & CACHE PURGING
# ------------------------------------------
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_API_TOKEN=""
CF_ACCOUNT_ID=""
CF_API_TOKEN=""
CF_ZONE_ID=""

# ------------------------------------------
# 4. CLOUDFLARE D1 DATABASE (If using external D1 API)
# ------------------------------------------
CF_DB_ID=""
CF_D1_TOKEN=""
CF_D1_READ_TOKEN=""

# ------------------------------------------
# 5. SUPABASE SETTINGS (If using Supabase instead of D1)
# ------------------------------------------
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------
# 6. STORAGE & MEDIA (R2)
# ------------------------------------------
R2_PUBLIC_URL=""

# ------------------------------------------
# 7. THIRD-PARTY APIs & TRACKING
# ------------------------------------------
GA4_API_SECRET=""
META_API_TOKEN=""
VERCEL_API_BASE=""
TAWK_WIDGET_URL=""

# ------------------------------------------
# 8. GITHUB INTEGRATION
# ------------------------------------------
GITHUB_OWNER=""
GITHUB_REPO=""
GITHUB_TOKEN=""
